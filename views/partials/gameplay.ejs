<!-- GAMEPLAY SECTION -->
<section id="gameplay" class="pattern-checkers">
  <div class="container">
    <h2 class="section-title pixel-font gs-pop"
      style="color: var(--brown-dark); text-shadow: 4px 4px 0 #FFF, 8px 8px 0 rgba(0,0,0,0.1);">Em Ação</h2>
    <p class="section-subtitle gs-pop">Assista à gravação da gameplay do protótipo</p>

    <div class="gs-elastic-box video-wrapper">
      <div class="video-inner" onclick="alert('Vídeo de demonstração estará disponível na apresentação final!');">
        <div class="video-thumbnail-bg vertical-parallax" data-speed="0.2"></div>
        <div class="video-sun vertical-parallax" data-speed="0.1"></div>
        <div class="video-hills vertical-parallax" data-speed="-0.1"></div>
        <div class="scanlines"></div>

        <div class="rec-indicator">
          <div class="rec-dot"></div>
          REC
        </div>

        <div class="btn-3d anime-pulse-btn"
          style="position: relative; z-index: 2; border-radius: 50%; width: clamp(70px, 15vw, 90px); height: clamp(70px, 15vw, 90px); padding: 0;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="#fff" style="margin-left: 6px;">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
